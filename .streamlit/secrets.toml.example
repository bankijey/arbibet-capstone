# Copy the values into Streamlit Cloud -> app -> Settings -> Secrets.
# Never commit a filled-in copy: .streamlit/secrets.toml is gitignored.
#
# Use the DASHBOARD user from snowflake/dashboard_role.sql, not an admin: the
# app is public, and this role can read the reporting schemas and write only
# the leg-flag table.

SNOWFLAKE_ACCOUNT = "ORGNAME-ACCOUNT"
SNOWFLAKE_USER = "ARBIBET_DASHBOARD"
SNOWFLAKE_PASSWORD = "CHANGE_ME"
SNOWFLAKE_ROLE = "ARBIBET_DASHBOARD"
SNOWFLAKE_WAREHOUSE = "COMPUTE_WH"
SNOWFLAKE_DATABASE = "ARBIBET_CAPSTONE"
SNOWFLAKE_SCHEMA = "CORE"
