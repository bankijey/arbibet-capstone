# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so it must
# never hold a real credential, host or personal path.
#
# Every value below is a placeholder. Anything reading CHANGE_ME will fail loudly
# at startup rather than half-working, which is the intent.

# =============================================================================
# Source databases -- HOST perspective
# =============================================================================
# All three are read-only. The pipeline never writes to a source.

# arbibet-markets bronze: the verbatim bookmaker payloads.
MARKETS_DB_URL=postgresql://USER:CHANGE_ME@localhost:5440/markets

# The sources database: arbibet-matcher's event_matches and the ingestor's
# apifootball_events projection.
SOURCES_DB_URL=postgresql://USER:CHANGE_ME@localhost:5433/Arbibet

# api-football-ingestor bronze: match history.
INGESTOR_DB_URL=postgresql://USER:CHANGE_ME@localhost:5434/ingestor

# =============================================================================
# Snowflake
# =============================================================================
# Account identifier: the <orgname>-<account_name> in your Snowsight URL, or
# run  SELECT CURRENT_ORGANIZATION_NAME() || '-' || CURRENT_ACCOUNT_NAME();
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNT
SNOWFLAKE_USER=CHANGE_ME
SNOWFLAKE_PASSWORD=CHANGE_ME
# The rest have defaults in code; override only if your account differs.
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=ARBIBET_CAPSTONE
SNOWFLAKE_SCHEMA=CORE

# =============================================================================
# OpenAI
# =============================================================================
# Required by enrich/summarise.py and enrich/fixture_summary.py -- they raise at
# startup without it. Snowflake Cortex was the original plan and would have been
# free, but its AI functions are unavailable on trial accounts.
OPENAI_KEY=sk-CHANGE_ME

# =============================================================================
# Kafka / Redpanda
# =============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC=market.ticks

# Two groups, not one. Kafka splits partitions across members of a consumer
# group, so both consumers in one group means one of them receives every
# message and the other receives nothing -- silently, with no error. Fan-out
# requires separate groups.
KAFKA_GROUP_ARB=capstone-arb
KAFKA_GROUP_EV=capstone-ev

# =============================================================================
# Spark  (flatten only -- settle is not a Spark job despite living in spark/)
# =============================================================================
# Spark 4.x requires Java 17 or 21. Java 25 fails at SparkContext init
# (Utils.getCurrentUserName -> Subject.getSubject, removed in Java 18+), and the
# usual -Djava.security.manager=allow workaround is gone too: Java 24 removed
# the Security Manager entirely (JEP 486).
# Use a path with NO SPACES -- and in bash this value must be quoted, or the
# shell eats the backslash and you get "The system cannot find the path".
JAVA_HOME=C:\path\to\jdk-17

# Without this, Spark launches bare `python` from PATH -- the system interpreter,
# where pyspark is not installed -- and the worker dies with a socket reset.
PYSPARK_PYTHON=C:\path\to\arbibet-capstone\.venv\Scripts\python.exe

# Optional. Defaults to local[*].
# SPARK_MASTER=local[*]

# =============================================================================
# Container-perspective DSNs
# =============================================================================
# The DSNs above are HOST-perspective (localhost). A container reaches the same
# databases at host.docker.internal, so Airflow needs its own copies -- one .env
# cannot describe two network positions. Likewise the broker: containers use the
# internal listener, the host uses the external one.
SOURCES_DB_URL_CONTAINER=postgresql://USER:CHANGE_ME@host.docker.internal:5433/Arbibet
MARKETS_DB_URL_CONTAINER=postgresql://USER:CHANGE_ME@host.docker.internal:5440/markets
INGESTOR_DB_URL_CONTAINER=postgresql://USER:CHANGE_ME@host.docker.internal:5434/ingestor
# The runner joins the source databases' Docker networks and connects by
# container name, which is ~35x faster than host.docker.internal for bronze.
SOURCES_DB_URL_RUNNER=postgresql://USER:CHANGE_ME@arbibet-scraper-postgres-1:5432/Arbibet
MARKETS_DB_URL_RUNNER=postgresql://USER:CHANGE_ME@arbibet-markets-db-1:5432/markets
INGESTOR_DB_URL_RUNNER=postgresql://USER:CHANGE_ME@ingestor-postgres:5432/ingestor
KAFKA_BOOTSTRAP_SERVERS_CONTAINER=redpanda:9092

# Airflow metadata DB (compose only; never read by the application).
AIRFLOW_POSTGRES_PASSWORD=CHANGE_ME
AIRFLOW_UID=50000

# =============================================================================
# Signal thresholds
# =============================================================================
# Below 1.0 records NEAR-arbitrage: markets where the best prices across books
# fall short of a guaranteed return, but only just. True surebets across public
# books are close to nonexistent, so this is what the table mostly holds. The
# `arbitrage` column says which a row is -- above 1.0 is a real surebet.
ARB_RECORD_THRESHOLD=0.98

# Positive-EV floors. min_probability excludes longshots, where a small error in
# an estimated probability swamps the edge.
EV_MIN=0.01
EV_MIN_PROBABILITY=0.5

# Consumers exit after this long with no new message, so a run terminates and
# can sit as an Airflow task.
IDLE_EXIT_SECONDS=10

# =============================================================================
# The live watcher (watch/signals.py) -- optional, all have defaults
# =============================================================================
# Long-running process that recomputes arbitrage/EV as new bronze prices land.
# The hours window is load-bearing: a 3-day window put 1,300+ fixtures in the
# poll and turned it into a 40-second sequential scan of a 7M-row table.
# WATCH_POLL_SECONDS=20
# WATCH_UNTIL_HOURS=6
# WATCH_REFRESH_SECONDS=300

# =============================================================================
# Batch bounding knobs -- optional, all default to the full job
# =============================================================================
# Prove a long job on a bound before running it whole. Two eighty-minute Spark
# runs were lost to failures a three-thousand-row run would have shown.

# spark/flatten.py
# FLATTEN_LIMIT=3000
# FLATTEN_SINCE_DAYS=3

# spark/settle.py
# SETTLE_LIMIT=500
# SETTLE_SINCE_DAYS=365
# SETTLE_PERIODS=match
# FORM_WINDOW=10

# odds/settle_fast.py -- pass 1: msport's final score, 105 min to 36 h after kick-off
# SETTLE_FAST_MIN_MINUTES=105
# SETTLE_FAST_MAX_HOURS=36
# SETTLE_FAST_BUDGET=150
# odds/settle_confirm.py -- pass 2: API-Football confirms, corrects and extends
# SETTLE_CONFIRM_MAX_DAYS=60

# odds/ticks.py -- incremental by default; full replay re-derives every tick
# from the start of bronze, which is what a parser fix requires.
# TICKS_LIMIT=5
# TICKS_FULL_REPLAY=1

# enrich/* -- these cost money per run, so they are bounded by default.
# SUMMARISE_LIMIT=20
# FIXTURE_SUMMARY_LIMIT=5

# =============================================================================
# Booking-slip ingestion (msport)
# =============================================================================
# This is a third party's production API and there is no agreement with them.
# Ten pages is ~200 slips; the list is ranked by popularity, so depth buys the
# slips people actually copy. One second between requests is ~2/min sustained.
# msport refreshes the list every 10 minutes, so hourly polling trades some
# coverage of short-lived codes for a much lighter footprint.
SLIP_MAX_PAGES=10
SLIP_REQUEST_DELAY_SECONDS=1.0
SLIP_TIMEOUT_SECONDS=30

# --- web app snapshots (publish/snapshot.py) ---------------------------------
# Vercel Blob read-write token for the store the web app reads. Without it the
# snapshot is only written to web/.data for local development.
BLOB_READ_WRITE_TOKEN=
# The deployed site's revalidate endpoint and the secret it expects, so pages
# refresh as soon as a snapshot is uploaded.
WEB_REVALIDATE_URL=https://<your-app>.vercel.app/api/revalidate
WEB_REVALIDATE_SECRET=

# Telegram bot (optional). Create a bot with @BotFather and paste its token.
# The runner starts the bot only when this is set. Keep it secret.
TELEGRAM_BOT_TOKEN=
# Optional: comma-separated chat ids allowed to use the bot; empty = anyone.
TELEGRAM_ALLOWED_CHATS=
# Optional: EV above this is treated as a mispriced market and never alerted.
TELEGRAM_EV_MAX=0.5
# Optional: the owner's chat id (send /start, then read it from bot.subscriber
# in Supabase). The owner has /admin and every signed-user feature.
TELEGRAM_OWNER_CHAT=
# Where deep-dive links point.
DASHBOARD_URL=https://arbibet.streamlit.app

# Match verification (src/arbibet_capstone/verify.py). The names check always
# runs and proposes candidates for the local review dashboard; set 1 to also
# ask gpt-4o-mini about names that only partly agree (a mismatch it proposes is
# confirmed by gpt-4o first). Nothing is excluded without a review decision.
VERIFY_WITH_MODEL=0
# Where the runner writes status and the review queue, and reads decisions.
# Inside Docker this is /data/local, bind-mounted from ./data/local.
LOCAL_DIR=data/local
