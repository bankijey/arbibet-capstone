.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# dbt build artifacts. Regenerated by every run, so committing them makes
# every diff after a `dbt run` look like 70 changed files.
dbt/target/
dbt/logs/
dbt/dbt_packages/

# Airflow task logs, bound from the container.
airflow/logs/

# Streamlit secrets: real credentials, local or pasted into Streamlit Cloud.
.streamlit/secrets.toml

# The local DuckDB warehouse. Real data; never committed.
data/
